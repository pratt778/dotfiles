{
  "files.autoSave": "onFocusChange",
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "dart.flutterSdkPath": "/home/pratham/flutter",
  "dart.devToolsLocation": {
    "default": "beside",
    "inspector": "sidebar"
  },
  "dart.analysisExcludedFolders": [
    "build",
    ".dart_tool"
  ],
  "dart.previewLsp": true,
  "dart.allowAnalytics": false,
  "dart.checkForSdkUpdates": false,
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/android/.gradle/**": true,
    "**/.git/objects/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.dart_tool": true,
    "**/android/.gradle": true
  },
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "explorer.confirmPasteNative": false,
  "git.enableSmartCommit": true,
  "git.autofetch": false,
  "editor.hover.enabled": "on",
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": false,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "explorer.confirmDelete": false,
  "editor.accessibilitySupport": "off",
  "accessibility.signalOptions.volume": 0,
  "java.jdt.ls.vmargs": "-Xmx768m",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "workbench.activityBar.location": "top",
  "kotlin.languageServer.enabled": false,
  "kotlin.debugAdapter.enabled": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "workbench.editorAssociations": {
    "*.png": "imagePreview.previewEditor"
  },
  "editor.codeActionsOnSave": {},
  "[dart]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.suggest.insertMode": "replace",
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.inlayHints.enabled": "offUnlessPressed"
  },
  "workbench.navigationControl.enabled": false,
  "chat.commandCenter.enabled": false,
  "window.commandCenter": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.useSystemClipboard": true,
  "editor.lineNumbers": "relative",
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "F"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    }
  ],
  "chat.editor.fontSize": 13,
  "debug.console.fontSize": 13,
  "terminal.integrated.fontSize": 13,
  "markdown.preview.fontSize": 13,
  "workbench.browser.showInTitleBar": false,
  "workbench.layoutControl.enabled": false,
  "dart.flutterCreatePromptForPlatforms": false,
  "dart.flutterCreatePlatforms": [
    "android",
    "ios"
  ],
  "telemetry.telemetryLevel": "off",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "workbench.colorTheme": "Dark Modern",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint"
  },
  "editor.fastScrollSensitivity": 20,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "editor.mouseWheelScrollSensitivity": 2.5,
  "workbench.list.mouseWheelScrollSensitivity": 2.5,
  "terminal.integrated.mouseWheelScrollSensitivity": 2
}